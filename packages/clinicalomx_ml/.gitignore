# data
*.zarr

# The old local working area for training data. It held 545 de-identified slide PNGs that were
# committed by accident and removed 2026-10-07; their governed copies are lamindb Collections
# (`clinical-roi/thumbnails`, `clinical-roi/shared/{pyramid_low_scale,tma_crops}`). The whole
# directory is ignored, so data dropped back here stays local. `roi_detection/tests/test_packaging.py` fails if
# anything under it is tracked anyway, which is what stops a `git add -f`.
roi_detection/objectives/

# Local materialization caches for the declarative data layer (data_io import).
# Canonical data lives in lamindb / RDM, not git.
_cache/

