# Monorepo-release render of the vm-process worker template; provenance and the HOME
# capture record are in infra/systemd/README.md. The template at
# packages/clinicalomxdb/hub-pipelines/prefect/workers/vm-process/vm-pool-worker.service
# stays authoritative for what this worker is.
#
# HOME here is the captured live-only drop-in override from the 2026-08-28 operator run
# (OP-8 class 2), baked in and relocated from the old checkout's
# hub-pipelines/prefect/worker-home/ to shared/runtime/ so it survives release flips.
# The Lamin settings directory follows HOME (verified hazard): this worker deliberately
# reads its own cached login, not the operator shell's /home/ubuntu/.lamin.
[Unit]
Description=Prefect process worker (vm-pool, VM small-job tier: mint-slides etc.)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=HOME=/opt/clinicalomx_data_platform/shared/runtime/worker-home
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/clinicalomx_data_platform/current/packages/clinicalomxdb/hub-pipelines/prefect/worker.env
EnvironmentFile=/opt/clinicalomx_data_platform/current/packages/clinicalomxdb/hub-pipelines/prefect/workers/vm-process/.env
WorkingDirectory=/opt/clinicalomx_data_platform/current/packages/clinicalomxdb/hub-pipelines/prefect
ExecStart=/opt/clinicalomx_data_platform/current/packages/clinicalomxdb/hub-pipelines/prefect/workers/vm-process/.venv/bin/prefect worker start --pool vm-pool --type process
Restart=always
RestartSec=5
# A stop is not a failure. Prefect's worker turns the SIGTERM systemd sends into a
# KeyboardInterrupt and exits 130, which systemd otherwise records as `failed`, so a
# clean drain left the unit red and a real fault looked the same as a planned stop.
# Restart=always is unaffected: it ignores the exit status either way.
SuccessExitStatus=130

[Install]
WantedBy=multi-user.target
