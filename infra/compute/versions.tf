terraform {
  required_version = ">= 1.7.0"

  required_providers {
    openstack = {
      source  = "terraform-provider-openstack/openstack"
      version = "~> 3.0"
    }
  }

  # Remote state in the same Nectar Swift container 
  backend "s3" {
    # bucket comes from TF_CLI_ARGS_init in infra/control_plane/.envrc.
    region = "us-east-1" # Ceph RGW zonegroup; part of SigV4, must be this literal

    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    use_path_style              = true
  }

  # Encrypt state at rest, kept for consistency with the control-plane root 
  encryption {
    key_provider "pbkdf2" "state" {
      passphrase = var.state_encryption_passphrase
    }
    method "aes_gcm" "state" {
      keys = key_provider.pbkdf2.state
    }
    state {
      method = method.aes_gcm.state
    }
    plan {
      method = method.aes_gcm.state
    }
  }
}
